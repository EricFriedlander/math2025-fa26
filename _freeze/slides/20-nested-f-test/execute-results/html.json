\"showscale\":false,\"inherit\":true}},\"layout\":{\"height\":450,\"margin\":{\"b\":0,\"l\":0,\"t\":30,\"r\":0},\"scene\":{\"xaxis\":{\"title\":\"X1\",\"range\":[-2.5,2.5]},\"yaxis\":{\"title\":\"X2\",\"range\":[-2.5,2.5]},\"zaxis\":{\"title\":\"Y\",\"range\":[-12,16]},\"aspectmode\":\"cube\",\"camera\":{\"eye\":{\"x\":1.7,\"y\":-1.7,\"z\":0.69999999999999996}}},\"autosize\":true,\"annotations\":[{\"text\":\"Fitted slopes: b1 = -1.34, b2 = 2.08   (truth: b1 = 0, b2 = 1)\",\"x\":0.5,\"y\":1,\"xref\":\"paper\",\"yref\":\"paper\",\"showarrow\":false,\"font\":{\"size\":16}}],\"updatemenus\":[{\"type\":\"buttons\",\"showactive\":false,\"x\":0,\"y\":0.90000000000000002,\"buttons\":[{\"method\":\"skip\",\"label\":\"New noise\"}]}],\"hovermode\":\"closest\",\"showlegend\":false},\"source\":\"A\",\"config\":{\"modeBarButtonsToAdd\":[\"hoverclosest\",\"hovercompare\"],\"showSendToCloud\":false,\"displayModeBar\":false},\"data\":[{\"x\":[-0.81031547189302355,0.10332756866208691,-1.0462268133293786,1.6953993114427977,0.26783628206948396,-1.0291288179478124,0.44594292232327293,0.72890783739561826,0.54558833497803594,-0.44821174733770647,1.6012268277809114,0.33588377285499404,-0.80443589117862691,-2.6015697694257427,1.1649297176248625,-0.15446586779152416,-0.12204857259909603,0.96068764342291035,0.82240008403815534,0.56602438316620951,0.932651369328382,0.77831939273830353,-0.01969307009572693,-2.3474177698573477,0.59526244733372047,-0.16709195007295499,-0.27949803605334683,-1.7625315484865236,-0.64305566022997063,0.36757359975648768,1.4285558964061382,-0.21971484880407391,0.33343457281817368,-0.16447123796472268,-1.6568629863988311,-0.5718276888255186,-0.54847663418991199,-0.1706836673442238,1.1368407663898976,0.75693531929562119],\"y\":[-0.80882389198350257,-0.038913632416097022,-0.71705381804661739,1.6370226765474842,-0.045612220830894723,-1.188733394041118,0.47547168298035003,0.86342949874928632,0.39753637723657809,-0.1291599052914324,1.4995500228675287,0.040610632167953631,-0