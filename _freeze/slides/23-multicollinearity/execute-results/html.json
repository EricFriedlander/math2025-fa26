9,180,1)\"},\"error_x\":{\"color\":\"rgba(31,119,180,1)\"},\"line\":{\"color\":\"rgba(31,119,180,1)\"},\"frame\":null},{\"colorbar\":{\"title\":\"\",\"ticklen\":2},\"colorscale\":[[\"0\",\"#533860\"],[\"1\",\"#533860\"]],\"showscale\":false,\"z\":[[0.34488768195938047,-6.3780584665407121],[10.728577398696967,4.0056312501968732]],\"type\":\"surface\",\"x\":[-2.5,2.5],\"y\":[-2.5,2.5],\"opacity\":0.75,\"frame\":null}],\"highlight\":{\"on\":\"plotly_click\",\"persistent\":false,\"dynamic\":false,\"selectize\":false,\"opacityDim\":0.20000000000000001,\"selected\":{\"opacity\":1},\"debounce\":0},\"shinyEvents\":[\"plotly_hover\",\"plotly_click\",\"plotly_selected\",\"plotly_relayout\",\"plotly_brushed\",\"plotly_brushing\",\"plotly_clickannotation\",\"plotly_doubleclick\",\"plotly_deselect\",\"plotly_afterplot\",\"plotly_sunburstclick\"],\"base_url\":\"https://plot.ly\"},\"evals\":[],\"jsHooks\":{\"render\":[{\"code\":\"\\n      function(el, x, d) {\\n        var n = d.x1.length, L = d.lim;\\n        function gauss() { var u = 1 - Math.random(), v = Math.random();\\n                           return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); }\\n        // least squares for y ~ 1 + x1 + x2 via the normal equations (3 x 3 Gaussian elimination)\\n        function fit(y) {\\n          var A = [[0,0,0],[0,0,0],[0,0,0]], c = [0,0,0], i, j, k, row;\\n          for (i = 0; i < n; i++) {\\n            row = [1, d.x1[i], d.x2[i]];\\n            for (j = 0; j < 3; j++) { c[j] += row[j] * y[i];\\n                                      for (k = 0; k < 3; k++) A[j][k] += row[j] * row[k]; }\\n          }\\n          for (j = 0; j < 3; j++) {\\n            for (i = j + 1; i < 3; i++) { var f = A[i][j] / A[j][j];\\n              for (k = j; k < 3; k++) A[i][k] -= f * A[j][k]; c[i] -= f * c[j]; }\\n          }\\n          var b = [0,0,0];\\n          for (j = 2; j >= 0; j--) { var s = c[j];\\n            for (k = j + 1; k < 3; k++) s -= A[j][k] * b[k]; b[j] = s / A[j][j]; }\\n          return b;\\n        }\\n        el.on('plotly_buttonclicked', function() {\\n          var y = [], i;\\n          for (i = 0; i < n; i++) y.push(d.beta[0] + d.beta[1] * d.x1[i] + d.beta[2] * d.x2[i] + d.sigma * gauss());\\n          var b = fit(y), e = [-L, L];\\n          var z = e.map(function(x2) { return e.map(function(x1) { return b[0] + b[1] * x1 + b[2] * x2; }); });\\n          Plotly.restyle(el, {z: [y]}, [0]);\\n          Plotly.restyle(el, {z: [z]}, [1]);\\n          Plotly.relayout(el, {'annotations[0].text': 'Fitted slopes: b1 = ' + b[1].toFixed(2) +\\n            ', b2 = ' + b[2].toFixed(2) + '   (truth: b1 = ' + d.beta[1] + ', b2 = ' + d.beta[2] + ')'});\\n        });\\n      }\",\"data\":{\"x1\":[-0.81031547189302355,0.10332756866208691,-1.0462268133293786,1.6953993114427977,0.26783628206948396,-1.0291288179478124,0.44594292232327293,0.72890783739561826,0.54558833497803594,-0.44821174733770647,1.6012268277809114,0.33588377285499404,-0.80443589117862691,-2.6015697694257427,1.1649297176248625,-0.15446586779152416,-0.12204857259909603,0.96068764342291035,0.82240008403815534,0.56602438316620951,0.932651369328382,0.77831939273830353,-0.01969307009572693,-2.3474177698573477,0.59526244733372047,-0.16709195007295499,-0.27949803605334683,-1.7625315484865236,-0.64305566022997063,0.36757359975648768,1.4285558964061382,-0.21971484880407391,0.33343457281817368,-0.16447123796472268,-1.6568629863988311,-0.5718276888255186,-0.54847663418991199,-0.1706836673442238,1.1368407663898976,0.75693531929562119],\"x2\":[-0.80882389198350257,-0.038913632416097022,-0.71705381804661739,1.6370226765474842,-0.045612220830894723,-1.188733394041118,0.47547168298035003,0.86342949874928632,0.39753637723657809,-0.1291599052914324,1.4995500228675287,0.040610632167953631,-0.62845895351722236,-2.7129641530513298,1.4758031624406893,0.50919118816777453,-0.27588158770347398,0.43844174671623032,0.87647226987326932,0.40757725338691386,1.6078711512691166,0.62682832922988085,0.18007139971348982,-2.0891890366044756,0.22244480703653902,-0.12269019927532115,-0.91206167128208038,-1.0784780092055564,-0.55212759126425448,1.033297461433091,1.3750469562985854,-0.48023268429541205,0.46216453883261072,-0.50948998410890489,-1.9281081507779794,-0.44181947950522038,-0.67595186846240063,-0.19087394996246615,0.98038493459887355,0.4174080920795129],\"beta\":[2,0,1],\"sigma\":1.5,\"lim\":2.5}}]}}</script>\n```\n\n:::\n:::\n\n\n::: question\nClick **New noise** several times (you can also rotate the plot). What does the plane do? How far does the `X1` slope stray from 0?\n:::\n\n## Uncorrelated predictors: a steady plane {.smaller}\n\nSame `X1`, same noise, same truth, but now `X1` and `X2` are uncorrelated ($r = 0$).\n\n\n::: {.cell layout-align=\"center\"}\n::: {.cell-output-display}\n\n```{=html}\n<div id=\"htmlwidget-10d37e8428da6b9e7447\" style=\"width:80%;height:450px;\" class=\"plotly html-widget\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-10d37e8428da6b9e7447\">{\"x\":{\"visdat\":{\"25fe9e63d552fd\":[\"function () \",\"plotlyVisDat\"]},\"cur_data\":\"25fe9e63d552fd\",\"attrs\":{\"25fe9e63d552fd\":{\"alpha_stroke\":1,\"sizes\":[10,100],\"spans\":[1,20],\"x\":[-0.81031547189302355,0.10332756866208691,-1.0462268133293786,1.6953993114427977,0.26783628206948396,-1.0291288179478124,0.44594292232327293,0.72890783739561826,0.54558833497803594,-0.44821174733770647,1.6012268277809114,0.33588377285499404,-0.80443589117862691,-2.6015697694257427,1.1649297176248625,-0.15446586779152416,-0.12204857259909603,0.96068764342291035,0.82240008403815534,0.56602438316620951,0.932651369328382,0.77831939273830353,-0.01969307009572693,-2.3474177698573477,0.59526244733372047,-0.16709195007295499,-0.27949803605334683,-1.7625315484865236,-0.64305566022997063,0.36757359975648768,1.4285558964061382,-0.21971484880407391,0.33343457281817368,-0.16447123796472268,-1.6568629863988311,-0.5718276888255186,-0.54847663418991199,-0.1706836673442238,1.1368407663898976,0.756